+	// Sidecar is the path to an associated XMP sidecar file that shares the
+	// image's base name (e.g. "IMG_1234.xmp" next to "IMG_1234.jpg"), or "" if
+	// the image has none. Sidecars carry no EXIF data of their own; they follow
+	// the image, taking the same target name with their own extension.
+	Sidecar string
+	// SidecarNewName is the sidecar's computed target, set by GenerateNewName
+	// alongside NewName whenever Sidecar is non-empty.
+	SidecarNewName string
 }
 
 // New creates a new Image object
@@ -27,6 +38,25 @@ func New(name string) *Image {
 	return &Image{OriginalName: name, NewName: name, Process: true}
 }
 
+// FindSidecar returns the path to an XMP sidecar file that shares imagePath's
+// base name, or "" if none exists. The sidecar is expected to differ from the
+// image only in extension (e.g. "IMG_1234.jpg" -> "IMG_1234.xmp"). Both common
+// extension casings are probed so the lookup works on case-sensitive
+// filesystems too.
+func FindSidecar(imagePath string) string {
+	base := strings.TrimSuffix(imagePath, filepath.Ext(imagePath))
+	for _, ext := range []string{".xmp", ".XMP"} {
+		candidate := base + ext
+		if candidate == imagePath {
+			continue
+		}
+		if info, err := os.Lstat(candidate); err == nil && !info.IsDir() {
+			return candidate
+		}
+	}
+	return ""
+}
+
 // ExtractDate extracts EXIF data from images or gets the file creation date if
 // it cannot find one
 func (i *Image) ExtractDate() error {
diff --git a/internal/ordnung/rename.go b/internal/ordnung/rename.go
index 674e9ca..2dea2e0 100644
--- a/internal/ordnung/rename.go
+++ b/internal/ordnung/rename.go
@@ -6,35 +6,50 @@ import (
 	"path/filepath"
 )
 
-// Rename moves the image from its original path to its computed NewName. It is
-// a no-op when the file is already correctly named, refuses to overwrite a
-// different file, and creates any destination subdirectories required by the
-// pattern.
+// Rename moves the image to its computed NewName and, if the image has an XMP
+// sidecar, moves that to SidecarNewName too. Each move is a no-op when the file
+// is already correctly named, refuses to overwrite a different file, and
+// creates any destination subdirectories required by the pattern.
 func (i *Image) Rename() error {
+	if err := moveFile(i.OriginalName, i.NewName); err != nil {
+		return err
+	}
+	if i.Sidecar != "" {
+		if err := moveFile(i.Sidecar, i.SidecarNewName); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// moveFile relocates src to dst. It is a no-op when dst equals src, refuses to
+// overwrite a *different* existing file, and creates any parent directories
+// required by dst (inheriting the source parent's permission bits).
+func moveFile(src, dst string) error {
 	// Nothing to do if the file is already named correctly. Avoids a needless
 	// syscall and keeps repeated runs side-effect free.
-	if i.NewName == i.OriginalName {
+	if dst == src {
 		return nil
 	}
 
-	srcInfo, err := os.Lstat(i.OriginalName)
+	srcInfo, err := os.Lstat(src)
 	if err != nil {
-		return fmt.Errorf("unable to stat source file %v: %v", i.OriginalName, err)
+		return fmt.Errorf("unable to stat source file %v: %v", src, err)
 	}
 
 	// Final safety net: never overwrite a *different* file that already occupies
 	// the target name. GenerateNewName should already guarantee this, but the
 	// check guards against races and changes made by other processes. SameFile
 	// allows a case-only rename (e.g. .JPG -> .jpg) on case-insensitive volumes.
-	if dstInfo, err := os.Lstat(i.NewName); err == nil && !os.SameFile(srcInfo, dstInfo) {
-		return fmt.Errorf("refusing to overwrite existing file: %v", i.NewName)
+	if dstInfo, err := os.Lstat(dst); err == nil && !os.SameFile(srcInfo, dstInfo) {
+		return fmt.Errorf("refusing to overwrite existing file: %v", dst)
 	}
 
 	// If the pattern renames into a directory structure, create it, inheriting
 	// the permission bits of the source's parent directory.
-	dNew, _ := filepath.Split(i.NewName)
+	dNew, _ := filepath.Split(dst)
 	if dNew != "" {
-		dOrig, _ := filepath.Split(i.OriginalName)
+		dOrig, _ := filepath.Split(src)
 		if dOrig == "" {
 			dOrig = "."
 		}
@@ -48,8 +63,8 @@ func (i *Image) Rename() error {
 		}
 	}
 
-	if err := os.Rename(i.OriginalName, i.NewName); err != nil {
-		return fmt.Errorf("error renaming %v to %v: %v", i.OriginalName, i.NewName, err)
+	if err := os.Rename(src, dst); err != nil {
+		return fmt.Errorf("error renaming %v to %v: %v", src, dst, err)
 	}
 
 	return nil
diff --git a/internal/ordnung/sidecar_test.go b/internal/ordnung/sidecar_test.go
new file mode 100644
index 0000000..988c1c0
--- /dev/null
+++ b/internal/ordnung/sidecar_test.go
@@ -0,0 +1,91 @@
+package ordnung
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/shoenig/test"
+	"github.com/shoenig/test/must"
+)
+
+// TestFindSidecar covers locating an XMP sidecar that shares the image's base
+// name, and returning "" when there is none.
+func TestFindSidecar(t *testing.T) {
+	dir := t.TempDir()
+	img := filepath.Join(dir, "IMG_1234.jpg")
+	xmp := filepath.Join(dir, "IMG_1234.xmp")
+	must.NoError(t, os.WriteFile(img, []byte("photo"), 0o644))
+
+	test.Eq(t, "", FindSidecar(img), test.Sprint("no sidecar should be found yet"))
+
+	must.NoError(t, os.WriteFile(xmp, []byte("edits"), 0o644))
+	test.Eq(t, xmp, FindSidecar(img), test.Sprint("sidecar sharing the base name should be found"))
+}
+
+// TestGenerateNewName_SetsSidecarTarget verifies that an image carrying a
+// sidecar gets a SidecarNewName that mirrors NewName but keeps the (lowercased)
+// sidecar extension.
+func TestGenerateNewName_SetsSidecarTarget(t *testing.T) {
+	d := time.Date(2021, 7, 15, 8, 15, 30, 0, time.UTC)
+	dir := t.TempDir()
+	suffix := timeSuffix(d)
+
+	src := filepath.Join(dir, "IMG_1234.jpg")
+	must.NoError(t, os.WriteFile(src, []byte("photo"), 0o644))
+
+	img := &Image{
+		OriginalName: src,
+		NewName:      src,
+		Date:         d,
+		Process:      true,
+		Sidecar:      filepath.Join(dir, "IMG_1234.xmp"),
+	}
+	img.GenerateNewName("YYYY-MM-DD", map[string]struct{}{})
+
+	wantImg := filepath.Join(dir, "2021-07-15_"+suffix+"-00.jpg")
+	wantSidecar := filepath.Join(dir, "2021-07-15_"+suffix+"-00.xmp")
+	test.Eq(t, wantImg, img.NewName)
+	test.Eq(t, wantSidecar, img.SidecarNewName, test.Sprint("sidecar should share the image's base name and counter"))
+}
+
+// TestGenerateNewName_NoSidecarLeavesTargetEmpty makes sure we don't invent a
+// sidecar target for images that have none.
+func TestGenerateNewName_NoSidecarLeavesTargetEmpty(t *testing.T) {
+	d := time.Date(2021, 7, 15, 8, 15, 30, 0, time.UTC)
+	dir := t.TempDir()
+	src := filepath.Join(dir, "IMG_1234.jpg")
+	must.NoError(t, os.WriteFile(src, []byte("photo"), 0o644))
+
+	img := &Image{OriginalName: src, NewName: src, Date: d, Process: true}
+	img.GenerateNewName("YYYY-MM-DD", map[string]struct{}{})
+
+	test.Eq(t, "", img.SidecarNewName)
+}
+
+// TestRename_MovesSidecarAlongsideImage is the end-to-end case: renaming an
+// image with a sidecar must move both files to their new names.
+func TestRename_MovesSidecarAlongsideImage(t *testing.T) {
+	dir := t.TempDir()
+	img := filepath.Join(dir, "IMG_1234.jpg")
+	xmp := filepath.Join(dir, "IMG_1234.xmp")
+	must.NoError(t, os.WriteFile(img, []byte("photo"), 0o644))
+	must.NoError(t, os.WriteFile(xmp, []byte("edits"), 0o644))
+
+	newImg := filepath.Join(dir, "2021-07-15_abcd-00.jpg")
+	newXMP := filepath.Join(dir, "2021-07-15_abcd-00.xmp")
+
+	i := &Image{
+		OriginalName:   img,
+		NewName:        newImg,
+		Sidecar:        xmp,
+		SidecarNewName: newXMP,
+	}
+	must.NoError(t, i.Rename())
+
+	test.FileNotExists(t, img)
+	test.FileNotExists(t, xmp)
+	test.FileContains(t, newImg, "photo")
+	test.FileContains(t, newXMP, "edits")
+}
